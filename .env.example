# Copy this file to `.env` and fill in your own Supabase project's values
# (Project Settings → API in the Supabase dashboard) to turn on shared,
# synced storage. Leave `.env` missing/empty to keep the original
# single-browser localStorage behavior — see README.md.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
